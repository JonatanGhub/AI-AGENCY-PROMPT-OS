{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-agency-prompt-os/registry/manifest.schema.json",
  "title": "Prompt OS Manifest",
  "description": "Esquema del manifiesto legible por máquina (registry/manifest.json): grafo de módulos y workflows que Cloud Code recorre programáticamente.",
  "type": "object",
  "required": ["name", "version", "modules", "workflows"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "department", "type", "version", "path", "consumes", "feeds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "department": { "type": "string", "enum": ["core", "product", "growth", "sales", "operations", "finance", "ai-engineering"] },
          "type": { "type": "string", "enum": ["pure-function", "coordinator", "executor"] },
          "version": { "type": "string", "pattern": "^v\\d+\\.\\d+$" },
          "path": { "type": "string" },
          "consumes": { "type": "array", "items": { "type": "string" } },
          "feeds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string" },
          "final_merge": { "type": "string" },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "soft_cycles": {
      "type": "array",
      "description": "Relaciones bidireccionales intencionadas, resueltas por iteración (no son ciclos en una sola ejecución).",
      "items": {
        "type": "object",
        "required": ["a", "b"],
        "additionalProperties": false,
        "properties": {
          "a": { "type": "string" },
          "b": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
